# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_NAME=Asystence

# ─── Database (use DATABASE_URL for Supabase / Railway) ───────────────────────
# Paste your Supabase "Transaction pooler" connection string here:
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Huddle realtime Redis is optional. Leave disabled unless explicitly testing
# Epic 4B+ locally/staging; Huddles continue to use the local realtime provider.
HUDDLE_REDIS_ENABLED=false
HUDDLE_REDIS_REQUIRED=false
HUDDLE_REALTIME_SHADOW_WRITE=false
HUDDLE_HEARTBEATS_ENABLED=false
HUDDLE_RECOVERY_SHADOW_ENABLED=false
HUDDLE_RECOVERY_SNAPSHOT_ENABLED=false
# Optional TTL for Redis shadow presence snapshots. Local presence remains authoritative.
# HUDDLE_REALTIME_SHADOW_TTL_SECONDS=300
# Optional heartbeat shadow telemetry tuning. Local presence remains authoritative.
# HUDDLE_HEARTBEAT_TTL_SECONDS=120
# HUDDLE_HEARTBEAT_STALE_AFTER_MS=45000
# Optional shadow recovery snapshot tuning. Recovery snapshots are diagnostic-only in Phase 1.
# HUDDLE_RECOVERY_SNAPSHOT_TTL_MS=30000
# HUDDLE_RECOVERY_SNAPSHOT_SOFT_LIMIT_BYTES=8192
# HUDDLE_RECOVERY_SNAPSHOT_HARD_LIMIT_BYTES=32768
# HUDDLE_RECOVERY_PARTICIPANT_LIMIT=50
# REDIS_URL=redis://localhost:6379

# Huddle LiveKit canary control plane. Mesh remains the default and fallback.
# Leave all flags disabled outside explicitly certified canary workspaces.
HUDDLE_MEDIA_PROVIDER=mesh
HUDDLE_MEDIA_FORCE_MESH=false
HUDDLE_LIVEKIT_FORCE_MESH=false
HUDDLE_LIVEKIT_ENABLED=false
HUDDLE_LIVEKIT_CANARY_ENABLED=false
HUDDLE_LIVEKIT_CANARY_WORKSPACES=
HUDDLE_LIVEKIT_CANARY_SDK_LOAD_ENABLED=false
HUDDLE_LIVEKIT_CANARY_CONNECTIVITY_ENABLED=false
HUDDLE_LIVEKIT_ROOM_ENDPOINT_ENABLED=false
HUDDLE_LIVEKIT_TOKEN_ENDPOINT_ENABLED=false
HUDDLE_LIVEKIT_TOKEN_TTL_SECONDS=600
HUDDLE_LIVEKIT_ROLLOUT_ENABLED=false
HUDDLE_LIVEKIT_ROLLOUT_STAGE=stage_0_internal_only
HUDDLE_LIVEKIT_SLO_JOIN_SUCCESS_RATE=0.99
HUDDLE_LIVEKIT_SLO_PUBLISH_SUCCESS_RATE=0.99
HUDDLE_LIVEKIT_SLO_RECONNECT_SUCCESS_RATE=0.98
HUDDLE_LIVEKIT_SLO_FALLBACK_SUCCESS_RATE=0.99
HUDDLE_LIVEKIT_SLO_PROVIDER_LOCK_VIOLATION_RATE=0.001
# LIVEKIT_URL=wss://your-livekit.example.com
# LIVEKIT_API_KEY=replace_with_livekit_api_key
# LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Frontend URL (used for CORS + email links) ────────────────────────────────
FRONTEND_URL=https://www.asystence.com
FRONTEND_BASE_URL=https://www.asystence.com

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Asystence <no-reply@asystence.com>
EMAIL_FROM=no-reply@asystence.com
EMAIL_FROM_NAME=Asystence

# ─── Storage: Cloudflare R2 (preferred) or AWS S3 ────────────────────────────
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your_r2_or_aws_access_key
AWS_SECRET_ACCESS_KEY=your_r2_or_aws_secret_key
# For Cloudflare R2: set R2_ACCOUNT_ID and point AWS_CDN_URL to your R2 public domain
R2_ACCOUNT_ID=your_cloudflare_account_id
AWS_CDN_URL=https://your-r2-public-domain.com
# For AWS S3 only (leave R2_ACCOUNT_ID blank):
# AWS_REGION=us-east-1
# AWS_CDN_URL=https://your-cloudfront-or-s3-url.com

# ─── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ATTENDANCE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.asystence.com/auth/google/callback

# ─── Asana OAuth ───────────────────────────────────────────────────────────────
ASANA_CLIENT_ID=your_asana_client_id
ASANA_CLIENT_SECRET=your_asana_client_secret
ASANA_REDIRECT_URI=https://api.asystence.com/oauth/asana/callback

# Optional: public API origin used for integration webhook callback URLs.
# If blank, the app derives it from ASANA_REDIRECT_URI or the current request host.
INTEGRATION_WEBHOOK_BASE_URL=https://api.asystence.com

# ─── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-8b-8192
OPENAI_API_KEY=your_openai_api_key
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=your_internal_ai_service_secret

# ─── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEFAULT_CURRENCY=usd
# Store Stripe Price IDs per billing plan via /superadmin/plans/:id/sync-stripe.
PAYMENTS_PROVIDER=razorpay
TRIAL_SIGNUP_PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_MONTHLY=120
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_YEARLY=10
BILLING_SUCCESS_URL=https://www.asystence.com/billing/success
BILLING_CANCEL_URL=https://www.asystence.com/billing/cancel
BILLING_PORTAL_RETURN_URL=https://www.asystence.com/settings/billing
API_PUBLIC_URL=https://api.asystence.com
TRIAL_SIGNUP_REQUIRE_PAYMENT=true
TRIAL_SIGNUP_REQUIRE_STRIPE=true
TRIAL_SIGNUP_PLAN_SLUG=pro
TRIAL_SIGNUP_CURRENCY=inr
TRIAL_SIGNUP_VERIFICATION_AMOUNT=100
# Optional override; defaults to API_PUBLIC_URL/auth/signup/workspace/complete/redirect.
# TRIAL_SIGNUP_SUCCESS_URL=https://api.asystence.com/auth/signup/workspace/complete/redirect?session_id={CHECKOUT_SESSION_ID}
# TRIAL_SIGNUP_CANCEL_URL=https://www.asystence.com/signup?cancelled=1


# ─── Git Webhook ───────────────────────────────────────────────────────────────
GIT_WEBHOOK_SECRET=your_git_webhook_secret

# ─── Backup / Recovery ─────────────────────────────────────────────────────────
BACKUP_LOCAL_DIR=/tmp/backups
BACKUP_RETENTION_DAYS=7
BACKUP_RUNNING_TIMEOUT_MINUTES=30
RECOVERY_HEARTBEAT_TIMEOUT_MINUTES=5

# ─── Migration only (remove after migration is done) ──────────────────────────
# NEW_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
