# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
NODE_ENV=development
DATABASE_ENV=development
PORT=5000
APP_NAME=Asystence
AUTH_DEV_MODE=true
AUTH_DEV_EMAIL=developer@localhost.test
AUTH_DEV_NAME=Asystence Developer
AUTH_DEV_WORKSPACE=Local Development

# ─── Database (use DATABASE_URL for Supabase / Railway) ───────────────────────
# Local development should use a local or disposable staging database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asystence_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asystence_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Huddle realtime Redis is optional. Leave disabled unless explicitly testing
# Epic 4B+ locally/staging; Huddles continue to use the local realtime provider.
HUDDLE_REDIS_ENABLED=false
HUDDLE_REDIS_REQUIRED=false
HUDDLE_REALTIME_SHADOW_WRITE=false
HUDDLE_HEARTBEATS_ENABLED=false
HUDDLE_RECOVERY_SHADOW_ENABLED=false
HUDDLE_RECOVERY_SNAPSHOT_ENABLED=false
# Optional TTL for Redis shadow presence snapshots. Local presence remains authoritative.
# HUDDLE_REALTIME_SHADOW_TTL_SECONDS=300
# Optional heartbeat shadow telemetry tuning. Local presence remains authoritative.
# HUDDLE_HEARTBEAT_TTL_SECONDS=120
# HUDDLE_HEARTBEAT_STALE_AFTER_MS=45000
# Optional shadow recovery snapshot tuning. Recovery snapshots are diagnostic-only in Phase 1.
# HUDDLE_RECOVERY_SNAPSHOT_TTL_MS=30000
# HUDDLE_RECOVERY_SNAPSHOT_SOFT_LIMIT_BYTES=8192
# HUDDLE_RECOVERY_SNAPSHOT_HARD_LIMIT_BYTES=32768
# HUDDLE_RECOVERY_PARTICIPANT_LIMIT=50
# REDIS_URL=redis://localhost:6379

# Huddle LiveKit canary control plane. Mesh remains the default and fallback.
# Leave all flags disabled outside explicitly certified canary workspaces.
HUDDLE_MEDIA_PROVIDER=mesh
HUDDLE_MEDIA_FORCE_MESH=false
HUDDLE_LIVEKIT_FORCE_MESH=false
HUDDLE_LIVEKIT_ENABLED=false
HUDDLE_LIVEKIT_CANARY_ENABLED=false
HUDDLE_LIVEKIT_CANARY_WORKSPACES=
HUDDLE_LIVEKIT_CANARY_SDK_LOAD_ENABLED=false
HUDDLE_LIVEKIT_CANARY_CONNECTIVITY_ENABLED=false
HUDDLE_LIVEKIT_ROOM_ENDPOINT_ENABLED=false
HUDDLE_LIVEKIT_TOKEN_ENDPOINT_ENABLED=false
HUDDLE_LIVEKIT_TOKEN_TTL_SECONDS=600
HUDDLE_LIVEKIT_ROLLOUT_ENABLED=false
HUDDLE_LIVEKIT_ROLLOUT_STAGE=stage_0_internal_only
HUDDLE_LIVEKIT_SLO_JOIN_SUCCESS_RATE=0.99
HUDDLE_LIVEKIT_SLO_PUBLISH_SUCCESS_RATE=0.99
HUDDLE_LIVEKIT_SLO_RECONNECT_SUCCESS_RATE=0.98
HUDDLE_LIVEKIT_SLO_FALLBACK_SUCCESS_RATE=0.99
HUDDLE_LIVEKIT_SLO_PROVIDER_LOCK_VIOLATION_RATE=0.001
# LIVEKIT_URL=wss://your-livekit.example.com
# LIVEKIT_API_KEY=replace_with_livekit_api_key
# LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Frontend URL (used for CORS + email links) ────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
API_PUBLIC_URL=http://localhost:5000
BACKEND_PUBLIC_URL=http://localhost:5000

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Asystence Local <no-reply@localhost.test>
EMAIL_FROM=no-reply@localhost.test
EMAIL_FROM_NAME=Asystence Local

# ─── Storage: Cloudflare R2 (preferred) or AWS S3 ────────────────────────────
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your_r2_or_aws_access_key
AWS_SECRET_ACCESS_KEY=your_r2_or_aws_secret_key
# For Cloudflare R2: set R2_ACCOUNT_ID and point AWS_CDN_URL to your R2 public domain
R2_ACCOUNT_ID=your_cloudflare_account_id
AWS_CDN_URL=https://your-r2-public-domain.com
# For AWS S3 only (leave R2_ACCOUNT_ID blank):
# AWS_REGION=us-east-1
# AWS_CDN_URL=https://your-cloudfront-or-s3-url.com

# ─── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ATTENDANCE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ─── Asana OAuth ───────────────────────────────────────────────────────────────
ASANA_CLIENT_ID=your_asana_client_id
ASANA_CLIENT_SECRET=your_asana_client_secret
ASANA_REDIRECT_URI=http://localhost:5000/oauth/asana/callback

# Optional: public API origin used for integration webhook callback URLs.
# If blank, the app derives it from ASANA_REDIRECT_URI or the current request host.
INTEGRATION_WEBHOOK_BASE_URL=http://localhost:5000

# ─── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-8b-8192
OPENAI_API_KEY=your_openai_api_key
AI_SERVICE_URL=http://localhost:5005/internal/chat-event
AI_SERVICE_SECRET=local-ai-service-secret
INTERNAL_SERVICE_SECRET=local-ai-service-secret

# ─── AI Platform (centralized gateway — see docs/ASYSTENCE_AI_PLATFORM_ARCHITECTURE_AND_PHASE1) ─
# Master switch. OFF (default) = legacy per-provider path, byte-for-byte unchanged.
# ON = all generateText() traffic flows through the centralized AI Platform gateway.
# Rollback for the entire platform is simply setting this back to false.
AI_PLATFORM_ENABLED=false
# Canary rollout: enable the platform for specific workspace ids only (comma-separated),
# leaving everyone else on the legacy path. Overrides AI_PLATFORM_ENABLED=false.
AI_PLATFORM_ENABLED_WORKSPACES=
# Best-effort request telemetry into ai_request_logs (safe to leave on).
AI_PLATFORM_TELEMETRY=true

# Smart automations. The worker processes the durable event queue in the API
# process; workspace administrators still control rule enablement and mode in
# the dashboard. Shadow is the safe default because it observes without taking
# automatic action.
ADAPTIVE_RUNTIME_WORKER_ENABLED=true
ADAPTIVE_RUNTIME_DEFAULT_MODE=shadow
ADAPTIVE_EVENT_CAPTURE_ENABLED=true
ADAPTIVE_WORKFLOWS_ENABLED=false
# Optional provider keys the platform can route to (only read inside adapters, never stored):
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
# TOGETHER_API_KEY=your_together_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Huddle transcription / live captions
HUDDLE_TRANSCRIPTION_ENABLED=false
HUDDLE_TRANSCRIPTION_PROVIDER=deepgram
HUDDLE_TRANSCRIPTION_MODEL=nova-3
HUDDLE_TRANSCRIPTION_LANGUAGE=en-US
HUDDLE_TRANSCRIPTION_TOKEN_TTL_SECONDS=300
HUDDLE_TRANSCRIPTION_REQUIRE_CONSENT=false
HUDDLE_CAPTIONS_ENABLED=true
HUDDLE_TRANSCRIPT_ARTIFACTS_ENABLED=true
DEEPGRAM_API_KEY=your_deepgram_api_key

# ─── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=usd
# Store Stripe Price IDs per billing plan via /superadmin/plans/:id/sync-stripe.
PAYMENTS_PROVIDER=local
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_MONTHLY=120
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_YEARLY=10
BILLING_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings/billing
# Self-serve paid-plan trials always start without a payment method.
TRIAL_SIGNUP_PLAN_SLUG=pro
TRIAL_FALLBACK_PLAN_SLUG=starter
# Legacy checkout-recovery settings below are retained only for sessions issued
# before the no-card rollout; new trial signups do not create a charge.
TRIAL_SIGNUP_CURRENCY=
# Refundable card-verification charge, in minor units of BILLING_BASE_CURRENCY.
# Other currencies use a per-currency minimum instead.
TRIAL_SIGNUP_VERIFICATION_AMOUNT=100
# Optional override; defaults to API_PUBLIC_URL/auth/signup/workspace/complete/redirect.
# TRIAL_SIGNUP_SUCCESS_URL=http://localhost:5000/auth/signup/workspace/complete/redirect?session_id={CHECKOUT_SESSION_ID}
# TRIAL_SIGNUP_CANCEL_URL=http://localhost:5173/signup?cancelled=1

# ─── Multi-currency pricing ────────────────────────────────────────────────────
# Plans are authored in this currency; every other currency derives from it.
BILLING_BASE_CURRENCY=usd
# Currencies offered to customers. Blank = the full built-in registry (~50).
# BILLING_SUPPORTED_CURRENCIES=usd,eur,gbp,inr,cad,aud,sgd,aed,jpy
#
# Which currencies each provider may be charged in. Stripe blank = all supported.
# Razorpay defaults to INR only: non-INR needs International Payments AND
# multi-currency Subscriptions enabled on the merchant account. Verify with
# GET /superadmin/plans/razorpay/currency-support before widening this.
RAZORPAY_SUPPORTED_CURRENCIES=inr
# STRIPE_SUPPORTED_CURRENCIES=
#
# FX rates: fetched from a keyless provider, cached in the fx_rates table, and
# only ever used to *generate* a local price — published prices never float.
FX_RATES_URL=https://open.er-api.com/v6/latest/USD
FX_RATES_TTL_HOURS=24
# Pin specific rates (overrides the provider), e.g. {"inr":88,"eur":0.92}
# FX_RATES_STATIC=


# ─── Git Webhook ───────────────────────────────────────────────────────────────
GIT_WEBHOOK_SECRET=your_git_webhook_secret

# ─── Backup / Recovery ─────────────────────────────────────────────────────────
BACKUP_LOCAL_DIR=/tmp/backups
BACKUP_RETENTION_DAYS=7
BACKUP_RUNNING_TIMEOUT_MINUTES=30
RECOVERY_HEARTBEAT_TIMEOUT_MINUTES=5

# Dedicated connection for pg_dump/psql. These tools need a SESSION-mode
# connection (a dump holds one consistent snapshot across many statements),
# whereas the application pool may point at a transaction-mode pooler for
# concurrency. Falls back to DATABASE_URL when unset.
# BACKUP_DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Off-site backup storage (S3-compatible; Cloudflare R2 shown). Without these,
# dumps are written to BACKUP_LOCAL_DIR only — which is NOT a real backup, since
# it shares the failure domain of the server it is protecting.
# BACKUP_S3_BUCKET=your-bucket
# BACKUP_S3_ACCESS_KEY=your_access_key
# BACKUP_S3_SECRET_KEY=your_secret_key
# BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# Abuse protection. Limits are keyed per-user where a user can be identified, so
# teams behind one office NAT address don't share a quota. Set to false to
# disable all limiting (kill switch) without a code change.
RATE_LIMIT_ENABLED=true

# ─── Migration only (remove after migration is done) ──────────────────────────
# NEW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asystence_dev_next
